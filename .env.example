# ---------------------------------------------------------------- 应用密钥
MYSQL_DATABASE=video_platform
MYSQL_USER=video
MYSQL_PASSWORD=replace-with-a-strong-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-strong-password
REDIS_PASSWORD=replace-with-a-strong-password
MINIO_USER=video_admin
MINIO_PASSWORD=replace-with-a-strong-password
# PKCS#8 私钥 DER 和 X.509 公钥 DER 的 Base64；见 README 的生成命令。
JWT_PRIVATE_KEY_BASE64=
JWT_PUBLIC_KEY_BASE64=
# 32 随机字节的 Base64，用于实名信息 AES-256-GCM 加密。
DATA_ENCRYPTION_KEY_BASE64=
# 仅 local 存储模式需要；MinIO 模式使用 S3 SigV4。
STORAGE_SIGNING_SECRET=replace-with-a-long-random-string

# ---------------------------------------------------------------- 登录限流
# 反代（compose 里的 nginx）后面 socket 地址是代理地址，此处保持 true 才能按真实客户端 IP 计数。
# 直接暴露 8080 且没有代理时应设为 false。
AUTH_TRUST_PROXY_HEADERS=true
# 仅在 HTTPS 入口后设为 true；http 部署下 Secure Cookie 会被浏览器丢弃。
AUTH_SECURE_COOKIE=false

# ---------------------------------------------------------------- Docker 国内源
# 运行时镜像仓库代理；国内网络建议保留默认值，需要官方源时改为 docker.io
DOCKER_REGISTRY=docker.m.daocloud.io
# 构建期镜像（留空或注释则使用 docker-compose.yml 中的国内源默认值）
# MAVEN_IMAGE=docker.m.daocloud.io/library/maven:3.9.11-eclipse-temurin-21-alpine
# JRE_IMAGE=docker.m.daocloud.io/library/eclipse-temurin:21-jre-alpine
# NODE_IMAGE=docker.m.daocloud.io/library/node:22-alpine
# NGINX_IMAGE=docker.m.daocloud.io/library/nginx:1.27-alpine
# 构建期依赖源；留空即回退 Maven Central / registry.npmjs.org
MAVEN_MIRROR_URL=https://maven.aliyun.com/repository/public
NPM_REGISTRY=https://registry.npmmirror.com
