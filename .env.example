MYSQL_DATABASE=video_platform
MYSQL_USER=video
MYSQL_PASSWORD=replace-with-a-strong-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-strong-password
REDIS_PASSWORD=replace-with-a-strong-password
MINIO_USER=video_admin
MINIO_PASSWORD=replace-with-a-strong-password
# PKCS#8 私钥 DER 和 X.509 公钥 DER 的 Base64；见 README 的生成命令。
JWT_PRIVATE_KEY_BASE64=
JWT_PUBLIC_KEY_BASE64=
# 32 随机字节的 Base64，用于实名信息 AES-256-GCM 加密。
DATA_ENCRYPTION_KEY_BASE64=
# 仅 local 存储模式需要；MinIO 模式使用 S3 SigV4。
STORAGE_SIGNING_SECRET=replace-with-a-long-random-string
