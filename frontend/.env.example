# 接口地址（同域部署时留空，走 /api 反代）
VITE_API_BASE_URL=
# 是否启用内置 Mock 数据层；默认连接真实后端，需要纯前端演示时改为 true
VITE_USE_MOCK=false
# 开发代理目标（后端 Spring Boot）
VITE_PROXY_TARGET=http://localhost:8080
# STOMP WebSocket 地址（默认与站点同源 /ws）
VITE_WS_URL=
# SSE 榜单推送地址
VITE_SSE_URL=
# 演示视频源（Mock 数据使用，指向 public/demo 下的 HLS）
VITE_DEMO_HLS_URL=/demo/hls/master.m3u8
